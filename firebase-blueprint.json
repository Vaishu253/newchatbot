{
  "entities": {
    "Conversation": {
      "title": "Conversation",
      "description": "A chat thread metadata containing title, tone, timestamps and ownership info.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "userId": { "type": "string", "maxLength": 128 },
        "title": { "type": "string", "maxLength": 200 },
        "tone": { "type": "string", "enum": ["professional", "casual", "concise"] },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "userId", "title", "tone", "createdAt", "updatedAt"]
    },
    "Message": {
      "title": "Message",
      "description": "An individual message within a conversation.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "conversationId": { "type": "string", "maxLength": 128 },
        "userId": { "type": "string", "maxLength": 128 },
        "role": { "type": "string", "enum": ["user", "model"] },
        "content": { "type": "string", "maxLength": 50000 },
        "tone": { "type": "string", "enum": ["professional", "casual", "concise"] },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "conversationId", "userId", "role", "content", "tone", "createdAt"]
    }
  },
  "firestore": {
    "/users/{userId}/conversations/{conversationId}": {
      "schema": "Conversation",
      "description": "Stores user chat conversations metadata"
    },
    "/users/{userId}/conversations/{conversationId}/messages/{messageId}": {
      "schema": "Message",
      "description": "Stores messages belonging to a conversation"
    }
  }
}
